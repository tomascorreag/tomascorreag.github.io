# Forces `npm run` to use git-bash instead of WSL bash (C:\Windows\System32\bash.exe),
# so the shell inherits the Windows PATH and can see ffmpeg, etc.
#
# PLATFORM CAVEAT: this path is Windows-specific. If cloning on macOS/Linux,
# delete this file — npm will fall back to /bin/sh, which is what the scripts
# expect there. Adjust the path if git-bash is installed elsewhere on your system
# (check with `where bash` in cmd). Backslashes must be escaped.
script-shell=C:\\Program Files\\Git\\bin\\bash.exe
